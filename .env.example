# Copie para `.env` e preencha. NUNCA commite o .env — segredos ficam no Vaultwarden.

# Token do bot (Discord Developer Portal). Guardar no Vaultwarden.
TOKEN=

# Conexão com o Postgres COMPARTILHADO do homelab (stack `postgres`).
# host = `postgres` (nome do serviço na rede Docker `postgres`); banco/usuário = hbot.
# A senha do usuário `hbot` é criada ao provisionar o banco (ver DEPLOY.md) e guardada no Vaultwarden.
DATABASE_URL=postgresql://hbot:SENHA_DO_HBOT@postgres:5432/hbot
